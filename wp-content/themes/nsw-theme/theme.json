{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-plain", "title": "Plain (no page hero)", "postTypes": [ "page" ] }
	],
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "768px",
			"wideSize": "1280px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "name": "Primary",         "slug": "primary",          "color": "#083D5D" },
				{ "name": "Primary Contrast","slug": "primary-contrast", "color": "#ffffff" },
				{ "name": "Secondary",       "slug": "secondary",        "color": "#0B4E75" },
				{ "name": "Red Dark",        "slug": "purple-dark",      "color": "#052A40" },
				{ "name": "Red Light",       "slug": "purple-light",     "color": "#8FCDF7" },
				{ "name": "Red Accent",      "slug": "purple-accent",    "color": "#42ADF1" },
				{ "name": "Foreground",      "slug": "foreground",       "color": "#222222" },
				{ "name": "Background",      "slug": "background",       "color": "#ffffff" },
				{ "name": "Muted",           "slug": "muted",            "color": "#F4F8FB" },
				{ "name": "Muted Text",      "slug": "muted-foreground", "color": "#5B7183" },
				{ "name": "Accent",          "slug": "accent",           "color": "#D6EBFA" },
				{ "name": "Border",          "slug": "border",           "color": "#DCE6EE" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{ "name": "Open Sans",  "slug": "sans",  "fontFamily": "'Open Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" },
				{ "name": "Montserrat", "slug": "serif", "fontFamily": "'Montserrat', 'Open Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" }
			],
			"fontSizes": [
				{ "name": "Small",   "slug": "small",   "size": "0.875rem" },
				{ "name": "Medium",  "slug": "medium",  "size": "1rem" },
				{ "name": "Large",   "slug": "large",   "size": "1.25rem" },
				{ "name": "X-Large", "slug": "x-large", "size": "1.875rem" },
				{ "name": "Huge",    "slug": "huge",    "size": "3rem" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "em", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "name": "Small",    "slug": "20", "size": "1rem" },
				{ "name": "Medium",   "slug": "40", "size": "2rem" },
				{ "name": "Large",    "slug": "60", "size": "4rem" },
				{ "name": "X-Large",  "slug": "80", "size": "5rem" }
			]
		},
		"border": {
			"radius": true,
			"color": true,
			"style": true,
			"width": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"padding": {
				"left": "1.5rem",
				"right": "1.5rem"
			},
			"blockGap": "1.5rem"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				":hover": { "typography": { "textDecoration": "underline" } }
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "700",
					"lineHeight": "1.2"
				},
				"color": { "text": "var(--wp--preset--color--foreground)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--primary-contrast)"
				},
				"border": { "radius": "0.375rem" },
				"spacing": { "padding": { "top": "0.6rem", "bottom": "0.6rem", "left": "1.1rem", "right": "1.1rem" } },
				":hover": {
					"color": { "background": "#052A40" }
				}
			}
		},
		"blocks": {
			"core/button": {
				"border": { "radius": "0.375rem" }
			},
			"core/heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--sans)", "fontWeight": "700" }
			}
		}
	}
}
